{
  "name": "comunicador-interareas",
  "version": "1.0.0",
  "description": "Sistema ficticio de comunicacao entre areas com registro de atendimentos",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "db:schema": "psql \"${DATABASE_URL:-postgres://comunicador:comunicador@localhost:5432/comunicador}\" -f db/schema.sql",
    "db:seed": "psql \"${DATABASE_URL:-postgres://comunicador:comunicador@localhost:5432/comunicador}\" -f db/seed.sql",
    "db:setup": "node scripts/migrate.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.23.0"
  }
}
